# Keep repository text deterministic across Windows and CI checkouts.
* text=auto

*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.pondex text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
NuGet.Config text eol=lf
*.sln text eol=crlf
*.ps1 text eol=crlf

# Audio, images, and Windows binaries must never be newline-normalized.
*.wav binary
*.mp3 binary
*.ogg binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.exe binary
*.dll binary
*.pdb binary
*.zip binary
